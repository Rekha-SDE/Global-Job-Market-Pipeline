# Python bytecode and cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment variables and local secrets
.env
.env.*
!.env.example

# Test and tooling caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Editor and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local data outputs (keep directory placeholders tracked if needed)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
